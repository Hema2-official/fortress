#!/usr/bin/env bash
# Tilion Fortress launcher - runs the stealth Chromium with a coherent default
# Windows persona + bundled fonts. Override any --uxr-* by passing your own.
# Env: TILION_NO_DEFAULTS=1 (skip default persona)  TILION_TZ / TILION_LANG (tweak)
set -e
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/tilion"; mkdir -p "$CACHE/fc"
CONF="$CACHE/fonts.conf"
sed -e "s|@FONTDIR@|$HERE/fonts|g" -e "s|@CACHEDIR@|$CACHE/fc|g" "$HERE/fonts/fonts.conf.template" > "$CONF"
export FONTCONFIG_FILE="$CONF"
export VK_ICD_FILENAMES="$HERE/vk_swiftshader_icd.json"
# shellcheck source=packaging/persona.sh
source "$HERE/persona.sh"
uxr_prepare_persona "$@"
CHROME_ARGS=(--use-angle=swiftshader --enable-unsafe-webgpu
  --enable-features=Vulkan --use-webgpu-adapter=swiftshader
  --enable-dawn-features=use_vulkan "${UXR_DEFAULTS[@]}" "${UXR_ARGS[@]}")
if [[ "${TILION_EPHEMERAL:-}" != 1 ]]; then
  exec "$HERE/chrome" "${CHROME_ARGS[@]}"
fi
EPHEMERAL_DIR="$(mktemp -d "${TMPDIR:-/tmp}/tilion-profile.XXXXXXXX")"
CHILD_PID=""
cleanup() {
  if [[ -n "$CHILD_PID" ]] && kill -0 "$CHILD_PID" 2>/dev/null; then
    kill "$CHILD_PID"
    wait "$CHILD_PID" || echo 'tilion: child terminated during ephemeral cleanup' >&2
  fi
  rm -rf -- "$EPHEMERAL_DIR"
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
# This final switch intentionally wins over any persistent profile argument.
"$HERE/chrome" "${CHROME_ARGS[@]}" "--user-data-dir=$EPHEMERAL_DIR" &
CHILD_PID=$!
status=0
wait "$CHILD_PID" || status=$?
exit "$status"
